{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motivaion",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false }
}
